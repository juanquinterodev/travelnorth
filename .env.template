# Copia este archivo como ".env" (sin el .template) y completa con los datos
# de tu proyecto en Neon.tech o Supabase. El archivo ".env" real NUNCA se sube
# al repo (ver .gitignore).

# Ejemplo de conexion para Neon:
# DB_URL=jdbc:postgresql://ep-xxxx.us-east-2.aws.neon.tech/travelnorth?sslmode=require
DB_URL=jdbc:postgresql://<host>:5432/<nombre_base_datos>?sslmode=require
DB_USERNAME=<usuario>
DB_PASSWORD=<password>
